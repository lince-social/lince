get_filename_component(LINCE_FIRMWARE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${LINCE_FIRMWARE_DIR}/board.json" LINCE_BOARD)
string(JSON LINCE_BOARD_VERSION GET "${LINCE_BOARD}" version)
string(JSON LINCE_BOARD_CHIP GET "${LINCE_BOARD}" chip)
string(JSON LINCE_BOARD_FLASH GET "${LINCE_BOARD}" minimum_flash_bytes)
if(NOT LINCE_BOARD_VERSION STREQUAL "1" OR NOT LINCE_BOARD_CHIP STREQUAL "esp32s3")
    message(FATAL_ERROR "Select a supported ESP32-S3 board profile")
endif()
set(LINCE_SUPPORTED_FLASH 4194304 8388608 16777216 33554432)
if(NOT LINCE_BOARD_FLASH IN_LIST LINCE_SUPPORTED_FLASH)
    message(FATAL_ERROR "Unsupported minimum physical flash capacity in board.json")
endif()

set(LINCE_BOARD_DEFAULTS "")
string(JSON LINCE_PSRAM_TYPE TYPE "${LINCE_BOARD}" psram)
if(LINCE_PSRAM_TYPE STREQUAL "NULL")
    string(APPEND LINCE_BOARD_DEFAULTS "CONFIG_SPIRAM=n\n")
elseif(LINCE_PSRAM_TYPE STREQUAL "OBJECT")
    string(JSON LINCE_PSRAM_MODE GET "${LINCE_BOARD}" psram mode)
    string(JSON LINCE_PSRAM_SPEED GET "${LINCE_BOARD}" psram speed_mhz)
    if(NOT LINCE_PSRAM_MODE MATCHES "^(quad|octal)$" OR NOT LINCE_PSRAM_SPEED MATCHES "^(40|80)$")
        message(FATAL_ERROR "Unsupported PSRAM mode or clock in board.json")
    endif()
    string(APPEND LINCE_BOARD_DEFAULTS "CONFIG_SPIRAM=y\nCONFIG_SPIRAM_SPEED_${LINCE_PSRAM_SPEED}M=y\n")
    if(LINCE_PSRAM_MODE STREQUAL "octal")
        string(APPEND LINCE_BOARD_DEFAULTS "CONFIG_SPIRAM_MODE_OCT=y\n")
    else()
        string(APPEND LINCE_BOARD_DEFAULTS "CONFIG_SPIRAM_MODE_QUAD=y\n")
    endif()
else()
    message(FATAL_ERROR "PSRAM must be null or an explicit memory configuration")
endif()

string(JSON LINCE_CAMERA_TYPE TYPE "${LINCE_BOARD}" camera)
if(LINCE_CAMERA_TYPE STREQUAL "NULL")
    set(LINCE_CAMERA_CLOCK 0)
elseif(LINCE_CAMERA_TYPE STREQUAL "OBJECT")
    string(JSON LINCE_CAMERA_CLOCK GET "${LINCE_BOARD}" camera xclk_hz)
    if(NOT LINCE_CAMERA_CLOCK MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Camera clock must be an integer in board.json")
    endif()
    if(LINCE_CAMERA_CLOCK LESS 6000000 OR LINCE_CAMERA_CLOCK GREATER 24000000)
        message(FATAL_ERROR "Choose a verified 6-24 MHz camera clock in board.json")
    endif()
else()
    message(FATAL_ERROR "Camera must be null or an explicit sensor configuration")
endif()
string(APPEND LINCE_BOARD_DEFAULTS "CONFIG_LINCE_CAMERA_XCLK_HZ=${LINCE_CAMERA_CLOCK}\n")

file(READ "${LINCE_FIRMWARE_DIR}/sdkconfig.defaults" LINCE_COMMON_DEFAULTS)
file(READ "${LINCE_FIRMWARE_DIR}/main/idf_component.yml" LINCE_COMPONENT_MANIFEST)
file(READ "${LINCE_FIRMWARE_DIR}/dependencies.lock" LINCE_COMPONENT_LOCK)
file(GLOB_RECURSE LINCE_COMPONENT_CONFIGS
    "${LINCE_FIRMWARE_DIR}/components/Kconfig"
    "${LINCE_FIRMWARE_DIR}/components/Kconfig.projbuild")
list(SORT LINCE_COMPONENT_CONFIGS)
set(LINCE_COMPONENT_CONFIG_INPUT "")
foreach(LINCE_CONFIG_FILE IN LISTS LINCE_COMPONENT_CONFIGS)
    file(RELATIVE_PATH LINCE_CONFIG_NAME "${LINCE_FIRMWARE_DIR}" "${LINCE_CONFIG_FILE}")
    file(READ "${LINCE_CONFIG_FILE}" LINCE_CONFIG_CONTENT)
    string(APPEND LINCE_COMPONENT_CONFIG_INPUT "\n${LINCE_CONFIG_NAME}\n${LINCE_CONFIG_CONTENT}")
endforeach()
string(SHA256 LINCE_CONFIG_DIGEST "${LINCE_COMMON_DEFAULTS}\n${LINCE_BOARD}\n${LINCE_BOARD_DEFAULTS}\n${LINCE_COMPONENT_MANIFEST}\n${LINCE_COMPONENT_LOCK}\n${LINCE_COMPONENT_CONFIG_INPUT}")
set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig-${LINCE_CONFIG_DIGEST}" CACHE FILEPATH "Ailuros SDK configuration selected by source inputs" FORCE)
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}")
file(WRITE "${CMAKE_BINARY_DIR}/sdkconfig.board" "${LINCE_BOARD_DEFAULTS}")
set(SDKCONFIG_DEFAULTS "${LINCE_FIRMWARE_DIR}/sdkconfig.defaults;${CMAKE_BINARY_DIR}/sdkconfig.board" CACHE STRING "Ailuros shared and board SDK defaults" FORCE)
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${LINCE_FIRMWARE_DIR}/board.json"
        "${LINCE_FIRMWARE_DIR}/sdkconfig.defaults"
        "${LINCE_FIRMWARE_DIR}/main/idf_component.yml"
        "${LINCE_FIRMWARE_DIR}/dependencies.lock"
        ${LINCE_COMPONENT_CONFIGS})
endif()
