   { kind "harvest" offset_days 14 title "Confirm laying; collect, inspect, label, and weigh eggs daily" }
   { kind "care" offset_days 379 title "Review health, measured laying rate, replacements, and humane retirement where needed; confirm actual remaining bird counts and clean empty housing" }
 ] }
