```python file=fitting_study.py
from fractions import Fraction as F
from linear_space_study import eliminate, scalar
import json


def fit(x, y):
    x = tuple(scalar(v) for v in x)
    y = tuple(scalar(v) for v in y)
    n = len(x)
    if n < 3 or len(y) != n or len(set(x)) < 2:
        raise ValueError('at least three paired readings and two input levels are required')
    normal = ((F(n), sum(x)), (sum(x), sum(v*v for v in x)))
    target = (sum(y), sum(v*w for v, w in zip(x, y)))
    alpha, beta = eliminate(normal, target)['particular']
    residual = tuple(w-alpha-beta*v for v, w in zip(x, y))
    sse = sum(v*v for v in residual)
    return {'alpha': alpha, 'beta': beta, 'residual': residual,
            'sse': sse, 'variance_estimate': sse/(n-2)}


def partition(x, y):
    x = tuple(scalar(v) for v in x)
    y = tuple(scalar(v) for v in y)
    result = fit(x, y)
    groups = {v: tuple(w for u, w in zip(x, y) if u == v) for v in set(x)}
    means = {v: sum(values)/len(values) for v, values in groups.items()}
    pure = sum((w-means[v])**2 for v, values in groups.items() for w in values)
    lack = sum(len(groups[v])*(m-result['alpha']-result['beta']*v)**2
               for v, m in means.items())
    return {'pure_error': pure, 'lack_of_fit': lack, 'sse': result['sse'],
            'pure_df': len(x)-len(groups), 'lack_df': len(groups)-2}


def investigation():
    x = (-2, -1, 0, 1, 2)
    e = (1, -1, 1, -1, 1)
    y = tuple(2+3*v+w for v, w in zip(x, e))
    return {'affine': fit(x, y), 'offset': fit(x, tuple(v+2 for v in y)),
            'curvature': fit(x, tuple(w+F(1, 2)*v*v for v, w in zip(x, y))),
            'replicates': partition((-1, -1, 0, 0, 1, 1),
                                    tuple(F(v, 4) for v in (-3, -1, 7, 9, 21, 23)))}


if __name__ == '__main__':
    print(json.dumps(investigation(), default=str, indent=2))
```

```python file=fitting_checks.py
from fractions import Fraction as F
from itertools import product
from fitting_study import fit, partition, investigation
import json


checks = 0


def check(value):
    global checks
    checks += 1
    assert value


def centered(x, y):
    xbar, ybar = sum(x)/F(len(x)), sum(y)/F(len(y))
    slope = sum((v-xbar)*(w-ybar) for v, w in zip(x, y))/sum((v-xbar)**2 for v in x)
    intercept = ybar-slope*xbar
    residual = tuple(w-intercept-slope*v for v, w in zip(x, y))
    return intercept, slope, residual, sum(v*v for v in residual)


def average(values):
    values = tuple(values)
    return sum(values)/F(len(values))


def covariance(a, b):
    a, b = tuple(a), tuple(b)
    return average(v*w for v, w in zip(a, b))-average(a)*average(b)


def run():
    x = tuple(map(F, (-2, -1, 0, 1, 2)))
    outcomes = list(product((-1, 1), repeat=5))
    fits = []
    mean_hits = future_narrow = future_wide = offset_hits = 0
    for errors in outcomes:
        y = tuple(2+3*v+e for v, e in zip(x, errors))
        result = fit(x, y)
        fits.append(result)
        independent = centered(x, y)
        check((result['alpha'], result['beta'], result['residual'], result['sse']) == independent)
        check(sum(result['residual']) == 0)
        check(sum(v*r for v, r in zip(x, result['residual'])) == 0)
        mean_hits += abs(result['alpha']-2) <= F(3, 5)
        offset = fit(x, tuple(v+2 for v in y))
        check(offset['residual'] == result['residual'])
        check(offset['alpha'] == result['alpha']+2)
        offset_hits += abs(offset['alpha']-2) <= F(3, 5)
        for future_error in (-1, 1):
            future_narrow += abs(result['alpha']-2-future_error) <= F(3, 5)
            future_wide += abs(result['alpha']-2-future_error) <= F(8, 5)
    a, b = [r['alpha'] for r in fits], [r['beta'] for r in fits]
    check(average(a) == 2 and average(b) == 3)
    check(covariance(a, a) == F(1, 5))
    check(covariance(b, b) == F(1, 10))
    check(covariance(a, b) == 0)
    check(average(r['sse'] for r in fits) == 3)
    check(average(r['variance_estimate'] for r in fits) == 1)
    check((mean_hits, future_narrow, future_wide, offset_hits) == (30, 12, 62, 0))
    for i, j in product(range(5), repeat=2):
        expected = F(i == j)-F(1, 5)-x[i]*x[j]/10
        check(covariance([r['residual'][i] for r in fits],
                         [r['residual'][j] for r in fits]) == expected)
    common = [fit(x, tuple(2+3*v+e+c for v, e in zip(x, errors)))
              for errors in outcomes for c in (-1, 1)]
    check(covariance([r['alpha'] for r in common], [r['alpha'] for r in common]) == F(6, 5))
    check(covariance([r['beta'] for r in common], [r['beta'] for r in common]) == F(1, 10))
    check(average(r['sse'] for r in common) == 3)
    curved = [fit(x, tuple(2+3*v+v*v/2+e for v, e in zip(x, errors))) for errors in outcomes]
    check(average(r['alpha'] for r in curved) == 3)
    check(average(r['sse'] for r in curved) == F(13, 2))
    check(average(r['variance_estimate'] for r in curved) == F(13, 6))
    observed = investigation()
    check(observed['affine']['alpha'] == F(11, 5))
    check(observed['affine']['residual'] == tuple(F(v, 5) for v in (4, -6, 4, -6, 4)))
    check(observed['affine']['sse'] == F(24, 5))
    check(observed['curvature']['alpha'] == F(16, 5))
    check(observed['curvature']['sse'] == F(123, 10))
    check(observed['replicates'] == {'pure_error': F(3, 8), 'lack_of_fit': F(1, 3),
                                   'sse': F(17, 24), 'pure_df': 3, 'lack_df': 1})
    cases = 0
    for shift, scale, alpha, beta, errors in product((-3, 0, 4), (F(1, 2), F(2)),
                                                    (-2, 5), (-3, 0, 2), outcomes):
        xx = tuple(shift+scale*v for v in x)
        yy = tuple(alpha+beta*v+e for v, e in zip(xx, errors))
        result = fit(xx, yy)
        independent = centered(xx, yy)
        check((result['alpha'], result['beta'], result['residual'], result['sse']) == independent)
        transformed = fit(x, yy)
        check(transformed['alpha'] == result['alpha']+shift*result['beta'])
        check(transformed['beta'] == scale*result['beta'])
        check(transformed['residual'] == result['residual'])
        cases += 1
    replicated = 0
    for ys in product((-1, 0, 2), repeat=6):
        xx = (-1, -1, 0, 0, 1, 1)
        result = partition(xx, ys)
        independent = centered(xx, ys)
        within = sum(F((ys[i]-ys[i+1])**2, 2) for i in (0, 2, 4))
        check(result['pure_error'] == within)
        check(result['sse'] == independent[3])
        check(result['sse'] == result['pure_error']+result['lack_of_fit'])
        check(result['pure_df']+result['lack_df'] == 4)
        replicated += 1
    for xx, yy in [([], []), ([1, 2], [1, 2]), ([1, 1, 1], [2, 3, 4]),
                   ([1, 2, 3], [1, 2]), ([True, 2, 3], [1, 2, 3]),
                   ([1.0, 2, 3], [1, 2, 3]), ([1, 2, 3], [1, float('nan'), 3])]:
        try:
            fit(xx, yy)
        except ValueError:
            check(True)
        else:
            raise AssertionError('invalid input accepted')
    print(json.dumps({'checks': checks, 'affine_cases': cases, 'replication_cases': replicated,
                      'independent_error_states': 32, 'common_error_states': 64,
                      'coverage_counts': [mean_hits, future_narrow, future_wide, offset_hits]}))


if __name__ == '__main__':
    run()
```

**Author verification:** the companion passed 7,735 exact checks through Nix/Python 3.14.8: 1,152 affine coordinate/parameter cases, 729 replicated response sets, 32 independent-error states and 64 common-error states, residual covariance, interval coverage and invalid inputs. The installed shared linear solver is reused unchanged. These calculations check the declared synthetic model, not an instrument or experiment.

