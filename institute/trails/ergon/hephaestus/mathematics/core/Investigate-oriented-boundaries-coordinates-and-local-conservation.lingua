```python file=field_study.py
from fractions import Fraction as F
from linear_space_study import scalar
from multivariable_study import segment_integral, value
import json


def exact_tuple(values, size):
    result = tuple(scalar(v) for v in values)
    if len(result) != size:
        raise ValueError('wrong coordinate or coefficient count')
    return result


def bounds(values, dimension):
    result = tuple(exact_tuple(v, 2) for v in values)
    if len(result) != dimension or any(a >= b for a, b in result):
        raise ValueError('strictly increasing bounds required')
    return result


def cubic_rule(function, start, end):
    start, end = scalar(start), scalar(end)
    return (end-start)*(function(start)+4*function((start+end)/2)+function(end))/6


def tensor_rule(function, region):
    def integrate(prefix, remaining):
        if not remaining:
            return scalar(function(*prefix))
        a, b = remaining[0]
        return cubic_rule(lambda x: integrate(prefix+(x,), remaining[1:]), a, b)
    return integrate((), region)


def dot(a, b):
    return sum((x*y for x, y in zip(a, b, strict=True)), F(0))


def cross(a, b):
    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2],
            a[0]*b[1]-a[1]*b[0])


def box_field(point, coefficients):
    x, y, z = point
    a, b, c, d, e, f = coefficients
    return a*x*x+b*y, c*y*y+d*z, e*z*z+f*x


def box_flux(region, coefficients):
    region, coefficients = bounds(region, 3), exact_tuple(coefficients, 6)
    faces = []
    for axis, (low, high) in enumerate(region):
        others = tuple(j for j in range(3) if j != axis)
        other_bounds = tuple(region[j] for j in others)
        for coordinate, sign in ((low, -1), (high, 1)):
            def integrand(u, v):
                point = [F(0)]*3
                point[axis] = coordinate
                point[others[0]], point[others[1]] = u, v
                return sign*box_field(point, coefficients)[axis]
            faces.append(tensor_rule(integrand, other_bounds))
    volume = product_widths(region)
    a, _, c, _, e, _ = coefficients
    region_integral = volume*sum(k*(lo+hi) for k, (lo, hi) in zip((a, c, e), region))
    return {'faces': tuple(faces), 'boundary': sum(faces), 'region': region_integral}


def product_widths(region):
    result = F(1)
    for low, high in region:
        result *= high-low
    return result


def rectangle_edges(region):
    (u0, u1), (v0, v1) = region
    return (((u0, v0), (u1, v0)), ((u1, v0), (u1, v1)),
            ((u1, v1), (u0, v1)), ((u0, v1), (u0, v0)))


def patch_field(point, coefficients):
    x, y, _ = point
    a, b, c = coefficients
    return -a*y*y, b*x*x, c*x*y


def patch(region, coefficients, shape):
    region = bounds(region, 2)
    coefficients, shape = exact_tuple(coefficients, 3), exact_tuple(shape, 3)
    a, b, c = coefficients
    h, k, q = shape
    def position(u, v):
        return u, v, h*u+k*v+q*u*v
    def tangents(u, v):
        return (F(1), F(0), h+q*v), (F(0), F(1), k+q*u)
    edges = []
    for start, end in rectangle_edges(region):
        du, dv = tuple(y-x for x, y in zip(start, end))
        def line(t):
            u, v = start[0]+t*du, start[1]+t*dv
            pu, pv = tangents(u, v)
            tangent = tuple(du*x+dv*y for x, y in zip(pu, pv))
            return dot(patch_field(position(u, v), coefficients), tangent)
        edges.append(cubic_rule(line, 0, 1))
    def surface(u, v):
        curl = (c*u, -c*v, 2*b*u+2*a*v)
        return dot(curl, cross(*tangents(u, v)))
    surface_integral = tensor_rule(surface, region)
    (u0, u1), (v0, v1) = region
    analytic = product_widths(region)*((2*b-c*h)*(u0+u1)+(2*a+c*k)*(v0+v1))/2
    return {'edges': tuple(edges), 'boundary': sum(edges),
            'surface': surface_integral, 'analytic': analytic}


def hemisphere(radius, slope, offset):
    radius, slope, offset = (scalar(v) for v in (radius, slope, offset))
    if radius <= 0:
        raise ValueError('positive radius required')
    curved_pi = cubic_rule(lambda z: 2*z*(slope*z+offset), 0, radius)
    disk_pi = -offset*radius*radius
    volume_pi = slope*F(2, 3)*radius**3
    return {'curved_pi': curved_pi, 'disk_pi': disk_pi,
            'boundary_pi': curved_pi+disk_pi, 'region_pi': volume_pi}


def local_balance(region, coefficients, supply):
    region = bounds(region, 3)
    coefficients, supply = exact_tuple(coefficients, 6), scalar(supply)
    a, _, c, _, e, _ = coefficients
    storage_rate = tensor_rule(lambda x, y, z: supply-2*(a*x+c*y+e*z), region)
    flux = box_flux(region, coefficients)['boundary']
    source = supply*product_widths(region)
    return {'storage_rate': storage_rate, 'outward_flux': flux,
            'source': source, 'residual': storage_rate+flux-source}


def investigation():
    return {'box': box_flux(((0, 2), (-1, 1), (0, 3)), (1, 2, 3, -1, 2, 4)),
            'patch': patch(((0, 2), (-1, 1)), (1, 2, 3), (2, -1, 1)),
            'source_pi_coefficients': hemisphere(1, 1, 1),
            'changed_pi_coefficients': hemisphere(2, 3, -1),
            'balance': local_balance(((0, 2), (-1, 1), (0, 3)), (1, 2, 3, -1, 2, 4), 5),
            'shared_exact_path': segment_integral((0, 0), (1, 1)),
            'shared_endpoint_difference': value((1, 1))-value((0, 0))}


if __name__ == '__main__':
    print(json.dumps(investigation(), default=str, indent=2))
```

```python file=field_checks.py
from fractions import Fraction as F
from itertools import product
import json
import field_study as s


def verify():
    checks = 0
    def equal(left, right):
        nonlocal checks
        assert left == right, (left, right)
        checks += 1
    intervals = ((-2, -1), (-1, 1), (0, 2), (F(1, 3), F(5, 3)))
    for low, high in intervals:
        for degree in range(4):
            equal(s.cubic_rule(lambda x: x**degree, low, high),
                  (F(high)**(degree+1)-F(low)**(degree+1))/(degree+1))
    equal(s.cubic_rule(lambda x: x**4, 0, 1), F(5, 24))
    equal(s.cubic_rule(lambda x: x**4, 0, 1) == F(1, 5), False)
    boxes = 0
    for region in product(intervals, repeat=3):
        for a, c, e in product((-1, 0, 2), repeat=3):
            coefficients = (a, 3, c, -2, e, 1)
            result = s.box_flux(region, coefficients)
            equal(result['boundary'], result['region'])
            (x0, x1), (y0, y1), (z0, z1) = region
            dx, dy, dz = F(x1-x0), F(y1-y0), F(z1-z0)
            expected = (F(a)*(F(x1)**2-F(x0)**2)*dy*dz
                        +F(c)*(F(y1)**2-F(y0)**2)*dx*dz
                        +F(e)*(F(z1)**2-F(z0)**2)*dx*dy)
            equal(result['boundary'], expected)
            balance = s.local_balance(region, coefficients, 5)
            equal(balance['residual'], 0)
            midpoint = (F(x0)+F(x1))/2
            left = ((x0, midpoint), region[1], region[2])
            right = ((midpoint, x1), region[1], region[2])
            lf, rf = s.box_flux(left, coefficients), s.box_flux(right, coefficients)
            equal(lf['faces'][1]+rf['faces'][0], 0)
            equal(lf['boundary']+rf['boundary'], result['boundary'])
            boxes += 1
    patches = 0
    for region in product(intervals, repeat=2):
        for coefficients in product((-1, 0, 2), repeat=3):
            for shape in ((0, 0, 0), (2, -1, 0), (2, -1, 3)):
                result = s.patch(region, coefficients, shape)
                equal(result['boundary'], result['surface'])
                equal(result['surface'], result['analytic'])
                (u0, u1), (v0, v1) = region
                midpoint = (F(u0)+F(u1))/2
                left = s.patch(((u0, midpoint), (v0, v1)), coefficients, shape)
                right = s.patch(((midpoint, u1), (v0, v1)), coefficients, shape)
                equal(left['edges'][1]+right['edges'][3], 0)
                equal(left['boundary']+right['boundary'], result['boundary'])
                patches += 1
    for radius, slope, offset in product((F(1, 2), F(1), F(2)), (-2, 0, 3), (-1, 0, 4)):
        result = s.hemisphere(radius, slope, offset)
        equal(result['boundary_pi'], result['region_pi'])
        equal(result['curved_pi'], F(2, 3)*slope*radius**3+offset*radius**2)
    source = s.hemisphere(1, 1, 1)
    equal(tuple(source.values()), (F(5, 3), F(-1), F(2, 3), F(2, 3)))
    equal(source['curved_pi']-source['disk_pi'] == source['region_pi'], False)
    a, b, c, d = 2, 1, 1, -1
    equal(abs(a*d-b*c), 3)
    equal(a*d-b*c == abs(a*d-b*c), False)
    equal(s.tensor_rule(lambda x, y: x, ((F(-1), F(1)), (F(0), F(1)))), 0)
    equal(s.tensor_rule(lambda x, y: x, ((F(0), F(1)), (F(0), F(1)))), F(1, 2))
    for start, end in product(product((-1, 0, 2), repeat=2), repeat=2):
        equal(s.segment_integral(start, end), s.value(end)-s.value(start))
        equal(s.segment_integral(end, start), -s.segment_integral(start, end))
    report = s.investigation()
    equal(report['box']['boundary'], 96)
    equal(report['patch']['boundary'], -8)
    equal(report['balance']['storage_rate'], -36)
    equal(report['changed_pi_coefficients']['boundary_pi'], 16)
    rejected = 0
    calls = [lambda: s.box_flux(((0, 0), (0, 1), (0, 1)), (1,)*6),
             lambda: s.box_flux(((1, 0), (0, 1), (0, 1)), (1,)*6),
             lambda: s.box_flux(((0, 1),), (1,)*6),
             lambda: s.box_flux(((0, 1),)*3, (1,)*5),
             lambda: s.box_flux(((0, True),)*3, (1,)*6),
             lambda: s.box_flux(((0, 1),)*3, (1.0,)*6),
             lambda: s.patch(((0, 1),)*2, (1,)*2, (1,)*3),
             lambda: s.patch(((0, 1),)*2, (1,)*3, (1,)*2),
             lambda: s.patch(((0, 1),)*2, (1,)*3, (True,)*3),
             lambda: s.hemisphere(0, 1, 1),
             lambda: s.hemisphere(-1, 1, 1),
             lambda: s.local_balance(((0, 1),)*3, (1,)*6, '1')]
    for call in calls:
        try:
            call()
        except (TypeError, ValueError):
            rejected += 1
        else:
            raise AssertionError('invalid input accepted')
    equal(rejected, len(calls))
    return {'checks': checks, 'boxes': boxes, 'patches': patches,
            'hemispheres': 27, 'rejected': rejected, 'example': report}


if __name__ == '__main__':
    print(json.dumps(verify(), default=str, indent=2))
```

