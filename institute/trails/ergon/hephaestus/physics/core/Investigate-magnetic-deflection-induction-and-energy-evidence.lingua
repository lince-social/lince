```python file=magnetic_study.py
from fractions import Fraction as F
from electric_study import exact, decay_bracket
from periodic_study import multiply, norm_squared
from field_study import cross, dot, bounds, rectangle_edges, cubic_rule
import json


def vector(values, size):
    result = tuple(exact(v) for v in values)
    if len(result) != size:
        raise ValueError('wrong coordinate count')
    return result


def force(charge, electric, velocity, magnetic):
    charge = exact(charge)
    electric, velocity, magnetic = (vector(v, 3) for v in (electric, velocity, magnetic))
    magnetic_force = tuple(charge*x for x in cross(velocity, magnetic))
    total = tuple(charge*x+y for x, y in zip(electric, magnetic_force))
    return {'force': total, 'magnetic_power': dot(magnetic_force, velocity),
            'total_power': dot(total, velocity)}


def orbit_phase(mass, charge, field, position, velocity, phase):
    mass, charge, field = (exact(v) for v in (mass, charge, field))
    position, velocity, phase = (vector(v, 2) for v in (position, velocity, phase))
    if mass <= 0 or charge*field == 0 or norm_squared(phase) != 1:
        raise ValueError('positive mass, nonzero frequency and unit phase required')
    omega = charge*field/mass
    c, s = phase
    updated = multiply((c, -s), velocity)
    x, y = position
    vx, vy = velocity
    ux, uy = updated
    point = (x+(vy-uy)/omega, y+(ux-vx)/omega)
    return {'position': point, 'velocity': updated, 'omega': omega,
            'center': (x+vy/omega, y-vx/omega),
            'energy': mass*norm_squared(updated)/2}


def fixed_induction(region, rate):
    region, rate = bounds(region, 2), exact(rate)
    edges = []
    for start, end in rectangle_edges(region):
        dx, dy = tuple(b-a for a, b in zip(start, end))
        def integrand(t):
            x, y = start[0]+t*dx, start[1]+t*dy
            return rate*(y*dx-x*dy)/2
        edges.append(cubic_rule(integrand, 0, 1))
    area = (region[0][1]-region[0][0])*(region[1][1]-region[1][0])
    return {'edges': tuple(edges), 'emf': sum(edges), 'flux_rate': rate*area}


def sliding_bar(field, length, speed, resistance):
    field, length, speed, resistance = (exact(v) for v in (field, length, speed, resistance))
    if length <= 0 or resistance <= 0:
        raise ValueError('positive length and resistance required')
    emf = field*length*speed
    current = emf/resistance
    force_x = -field*length*current
    return {'emf': emf, 'current_clockwise': current, 'force_x': force_x,
            'mechanical_input': -force_x*speed, 'joule': resistance*current**2}


def rl(emf, resistance, inductance, initial, decay):
    emf, resistance, inductance, initial, decay = (exact(v) for v in (emf, resistance, inductance, initial, decay))
    if resistance <= 0 or inductance <= 0 or not 0 <= decay <= 1:
        raise ValueError('positive components and decay in [0,1] required')
    final = emf/resistance
    current = final+(initial-final)*decay
    derivative = (emf-resistance*current)/inductance
    source_power = emf*current
    joule = resistance*current**2
    storage_rate = inductance*current*derivative
    return {'current': current, 'derivative': derivative, 'tau': inductance/resistance,
            'energy': inductance*current**2/2, 'source_power': source_power,
            'joule': joule, 'storage_rate': storage_rate,
            'balance': source_power-joule-storage_rate}


def planar_wave(permittivity, speed, amplitude, slope, offset, time, interval):
    permittivity, speed, amplitude, slope, offset, time = (exact(v) for v in (permittivity, speed, amplitude, slope, offset, time))
    ((left, right),) = bounds((interval,), 1)
    if permittivity <= 0 or speed <= 0:
        raise ValueError('positive medium parameters required')
    def profile(x):
        return slope*(x-speed*time)+offset
    def density(x):
        return permittivity*amplitude**2*profile(x)**2
    energy = cubic_rule(density, left, right)
    rate = cubic_rule(lambda x: -2*permittivity*amplitude**2*speed*slope*profile(x), left, right)
    outward = speed*(density(right)-density(left))
    return {'energy_per_area': energy, 'storage_rate_per_area': rate,
            'outward_per_area': outward, 'balance': rate+outward,
            'permeability': 1/(permittivity*speed**2)}


def published_rl():
    low, high = decay_bracket(1)
    low, high = low*low, high*high
    return {'tau': F(1), 'current_initial': F(0), 'current_limit': F(1, 2),
            'current_two_tau_bounds': ((1-high)/2, (1-low)/2),
            'induced_emf_magnitude_bounds': (2*low, 2*high)}


def investigation():
    return {'orbit': orbit_phase(2, 1, 3, (0, 0), (3, 4), (F(3, 5), F(4, 5))),
            'induction': fixed_induction(((0, 2), (-1, 1)), 3),
            'bar': sliding_bar(2, F(1, 2), 3, 4),
            'rl_half_decay': rl(3, 4, 2, 0, F(1, 2)),
            'same_current_rival': rl(6, 8, 4, 0, F(1, 2)),
            'wave': planar_wave(2, 3, 1, 1, 0, 0, (0, 2)),
            'published_rl': published_rl()}


if __name__ == '__main__':
    print(json.dumps(investigation(), default=str, indent=2))
```

```python file=magnetic_checks.py
from fractions import Fraction as F
from itertools import product
from decimal import Decimal as D, localcontext
import json
import magnetic_study as s


def verify():
    checks = 0
    def equal(a, b):
        nonlocal checks
        assert a == b, (a, b)
        checks += 1
    vectors = list(product((-1, 0, 2), repeat=3))
    force_cases = 0
    for velocity, magnetic in product(vectors, repeat=2):
        result = s.force(-2, (1, 2, -1), velocity, magnetic)
        equal(result['magnetic_power'], 0)
        equal(result['total_power'], -2*(velocity[0]+2*velocity[1]-velocity[2]))
        force_cases += 1
    phases = ((1, 0), (0, 1), (F(3, 5), F(4, 5)), (F(-5, 13), F(12, 13)))
    orbit_cases = 0
    for mass, charge, field, velocity, phase in product((1, 2), (-2, 1), (-1, 3), product((-2, 0, 3), repeat=2), phases):
        old = (F(1, 3), F(-2, 5))
        result = s.orbit_phase(mass, charge, field, old, velocity, phase)
        x, y = result['position'];vx, vy = result['velocity'];w = result['omega']
        equal((x+vy/w, y-vx/w), result['center'])
        equal(result['energy'], F(mass)*(velocity[0]**2+velocity[1]**2)/2)
        c, sn = phase;ux, uy = map(F, velocity)
        equal((x, y), (old[0]+(ux*sn+uy*(1-c))/w, old[1]+(uy*sn-ux*(1-c))/w))
        backward = s.orbit_phase(mass, charge, field, (x,y), (vx,vy), (c,-sn))
        equal(backward['position'], old);equal(backward['velocity'], tuple(map(F, velocity)))
        orbit_cases += 1
    induction_cases = 0
    intervals = ((-2, 1), (0, 2), (F(1, 3), F(4, 3)))
    for region, rate in product(product(intervals, repeat=2), (-3, 0, 2)):
        result = s.fixed_induction(region, rate)
        equal(result['emf'], -result['flux_rate'])
        (a,b),(c,d)=region
        expected = (F(rate)*c*(b-a)/2, -F(rate)*b*(d-c)/2,
                    -F(rate)*d*(b-a)/2, F(rate)*a*(d-c)/2)
        equal(result['edges'], expected)
        induction_cases += 1
    bar_cases = 0
    for field, length, speed, resistance in product((-2, 0, 3), (F(1,2),2), (-3,0,2), (1,4)):
        result=s.sliding_bar(field,length,speed,resistance)
        equal(result['mechanical_input'], result['joule'])
        equal(result['force_x']*speed <= 0, True)
        equal(result['emf'], -F(field)*length*(-F(speed)))
        bar_cases += 1
    rl_cases = 0
    for emf, resistance, inductance, initial, decay in product((-2,0,3), (1,4), (1,2), (-1,0,2), (0,F(1,3),F(1,2),1)):
        result = s.rl(emf,resistance,inductance,initial,decay)
        equal(result['balance'], 0)
        expected = F(emf,resistance)*(1-decay)+initial*decay
        equal(result['current'], expected)
        equal(result['derivative'], (F(emf,resistance)-initial)*decay*F(resistance,inductance))
        rival = s.rl(3*emf,3*resistance,3*inductance,initial,decay)
        equal(rival['current'], result['current']);equal(rival['tau'], result['tau'])
        equal(rival['energy'], 3*result['energy'])
        rl_cases += 1
    wave_cases = 0
    for epsilon, speed, amplitude, slope, offset, time in product((1,2),(1,3),(-2,1),(-1,0,2),(-1,1),(0,F(1,3))):
        result=s.planar_wave(epsilon,speed,amplitude,slope,offset,time,(-1,2))
        equal(result['balance'],0)
        b=F(offset)-slope*speed*time
        primitive=lambda x:F(slope*slope,3)*x**3+slope*b*x*x+b*b*x
        equal(result['energy_per_area'], epsilon*amplitude**2*(primitive(F(2))-primitive(F(-1))))
        equal(result['energy_per_area'] >= 0, True)
        wave_cases += 1
    report=s.investigation()
    equal(report['orbit']['position'], (F(8,3),F(4,3)))
    equal(report['orbit']['velocity'], (F(5),F(0)))
    equal(report['induction']['emf'], -12)
    equal(report['bar']['mechanical_input'], F(9,4))
    equal(report['rl_half_decay']['current'], F(3,8))
    equal(report['rl_half_decay']['source_power'], F(9,8))
    equal(report['rl_half_decay']['joule'], F(9,16))
    equal(report['rl_half_decay']['storage_rate'], F(9,16))
    equal(report['wave']['energy_per_area'], F(16,3))
    equal(report['wave']['outward_per_area'], 24)
    published=report['published_rl']
    with localcontext() as ctx:
        ctx.prec=60
        current=(1-(-D(2)).exp())/2
        voltage=2*(-D(2)).exp()
        for name,expected in [('current_two_tau_bounds',current),('induced_emf_magnitude_bounds',voltage)]:
            lo,hi=published[name]
            decimal=lambda f:D(f.numerator)/D(f.denominator)
            equal(decimal(lo)<expected<decimal(hi),True)
            equal(hi-lo<F(1,10**18),True)
        equal(current.quantize(D('0.01')),D('0.43'))
        equal(voltage.quantize(D('0.01')),D('0.27'))
    equal(s.rl(3,4,2,0,F(1,2))['current']==F(3,4),False)
    equal(report['rl_half_decay']['source_power']==report['rl_half_decay']['joule'],False)
    rejected=0
    calls=[lambda:s.force(True,(0,0,0),(1,0,0),(0,0,1)),
           lambda:s.force(1,(0,0),(1,0,0),(0,0,1)),
           lambda:s.orbit_phase(0,1,1,(0,0),(1,0),(1,0)),
           lambda:s.orbit_phase(1,0,1,(0,0),(1,0),(1,0)),
           lambda:s.orbit_phase(1,1,1,(0,0),(1,0),(1,1)),
           lambda:s.fixed_induction(((1,0),(0,1)),1),
           lambda:s.fixed_induction(((0,1),(0,1)),1.0),
           lambda:s.sliding_bar(1,0,1,1),
           lambda:s.sliding_bar(1,1,1,0),
           lambda:s.rl(1,1,0,0,1),
           lambda:s.rl(1,1,1,0,F(3,2)),
           lambda:s.rl(1,1,1,0,-1),
           lambda:s.planar_wave(0,1,1,1,1,0,(0,1)),
           lambda:s.planar_wave(1,-1,1,1,1,0,(0,1))]
    for call in calls:
        try:
            call()
        except ValueError:
            rejected+=1
        else:
            raise AssertionError('invalid input accepted')
    equal(rejected,len(calls))
    return {'checks':checks,'force_cases':force_cases,'orbit_cases':orbit_cases,
            'induction_cases':induction_cases,'bar_cases':bar_cases,'rl_cases':rl_cases,
            'wave_cases':wave_cases,'rejected':rejected,'published_rounding':['0.43 A','0.27 V']}


if __name__=='__main__':
    print(json.dumps(verify(),indent=2))
```

**Author verification:** Python 3.14.8 passed 4,231 assertions: 729 force cases, 288 orbit cases, 27 fixed-loop cases, 36 sliding-bar cases, 144 RL states/rivals, 96 wave slabs, the bounded published calculation and fourteen rejected calls. Exact independent formulas complement shared arithmetic; no apparatus, physical field or learner capability is validated.

