Temperate and mild-climate fruit (@farming-temperate-fruit: 0, #part-of @farming-orchards, #contains @prunus-salicina, #contains @diospyros-kaki, #contains @ficus-carica, #contains @actinidia-deliciosa, #contains @malus-domestica, #contains @fragaria-ananassa, #contains @eriobotrya-japonica, #contains @pyrus-communis, #contains @prunus-persica, #contains @punica-granatum, #contains @vitis-vinifera) { r_2J9WME5YFPFV9MY6J7PB5A4H7D
