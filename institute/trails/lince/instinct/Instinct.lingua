                    slug "step-area-place"
                    subject "areas-of-influence"
                } {
                    operation "Attract"
                    slug "step-area-attract"
                    subject "areas-of-influence"
                } {
                    operation "Repel"
                    slug "step-area-repel"
                    subject "areas-of-influence"
                }]
            subject "areas-of-influence"
        } {
            prerequisites ["record" "assertion" "areas-of-influence"]
